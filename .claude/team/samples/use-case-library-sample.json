{
  "format": "e3-use-case-library",
  "version": 1,
  "templates": [
    {
      "code": "UC-01",
      "name": "Abandoned cart",
      "type": "marketing",
      "description": "Recovers carts abandoned after an add-to-cart event with no completed checkout.",
      "tags": {
        "channels": ["email"],
        "goals": ["reactivate_customers"],
        "tiers": ["essentials"],
        "kpis": ["conversion_rate"],
        "industries": ["ecommerce"]
      },
      "flags": { "popular": true },
      "default_requirements": [
        {
          "target_kind": "variant",
          "event_name": "cart_update",
          "condition": { "property_name": "action", "value": "add" },
          "level": "R",
          "note": "The abandoned-cart trigger."
        },
        {
          "target_kind": "variant_property",
          "event_name": "cart_update",
          "property_name": "product_id",
          "condition": { "property_name": "action", "value": "add" },
          "level": "R"
        },
        {
          "target_kind": "variant_property",
          "event_name": "cart_update",
          "property_name": "total_price",
          "condition": { "property_name": "action", "value": "add" },
          "level": "R"
        },
        {
          "target_kind": "event",
          "event_name": "checkout",
          "level": "O",
          "note": "Suppresses the recovery email once checkout has started."
        },
        {
          "target_kind": "customer_property",
          "property_name": "email",
          "level": "R"
        }
      ]
    },
    {
      "code": "UC-02",
      "name": "Purchase confirmation",
      "type": "transactional",
      "description": "Sends a confirmation email for every successful purchase, with its line items.",
      "tags": {
        "channels": ["email"],
        "goals": ["increase_retention"],
        "tiers": ["essentials"],
        "kpis": ["revenue"],
        "industries": ["ecommerce", "travel", "retail"]
      },
      "flags": { "popular": true },
      "default_requirements": [
        {
          "target_kind": "variant",
          "event_name": "purchase",
          "condition": { "property_name": "purchase_status", "value": "success" },
          "level": "R"
        },
        {
          "target_kind": "variant_property",
          "event_name": "purchase",
          "property_name": "purchase_id",
          "condition": { "property_name": "purchase_status", "value": "success" },
          "level": "R"
        },
        {
          "target_kind": "variant_property",
          "event_name": "purchase",
          "property_name": "total_price",
          "condition": { "property_name": "purchase_status", "value": "success" },
          "level": "R"
        },
        {
          "target_kind": "event_property",
          "event_name": "purchase_item",
          "property_name": "price",
          "level": "R"
        },
        {
          "target_kind": "event_property",
          "event_name": "purchase_item",
          "property_name": "quantity",
          "level": "R"
        },
        {
          "target_kind": "customer_property",
          "property_name": "email",
          "level": "R"
        }
      ]
    },
    {
      "code": "UC-03",
      "name": "Back in stock",
      "type": "marketing",
      "description": "Notifies a customer when a viewed, out-of-stock product becomes available again.",
      "tags": {
        "channels": ["email", "sms"],
        "goals": ["reactivate_customers"],
        "tiers": ["advanced"],
        "kpis": ["conversion_rate"],
        "industries": ["ecommerce", "retail"]
      },
      "flags": { "new": true },
      "default_requirements": [
        {
          "target_kind": "event_property",
          "event_name": "view_item",
          "property_name": "product_id",
          "level": "R"
        },
        {
          "target_kind": "event_property",
          "event_name": "view_item",
          "property_name": "stock_level",
          "level": "R"
        },
        {
          "target_kind": "customer_property",
          "property_name": "phone",
          "level": "O"
        },
        {
          "target_kind": "event",
          "event_name": "wishlist_add",
          "level": "R",
          "note": "Deliberately unresolvable on the data-mapping fixture (no wishlist_add event is mapped); demonstrates a gap requirement."
        }
      ]
    }
  ]
}
