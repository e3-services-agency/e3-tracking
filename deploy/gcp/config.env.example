# Copy to config.env (gitignored) and adjust. Sourced by bash, so ${VAR} references work.
PROJECT_ID=e3-tracking
REGION=europe-west1
ZONE=europe-west1-b
HOSTNAME=tracking.e3-services.com
WORKSPACE_DOMAIN=e3-services.com
# D-72 amendment 1: start on e2-micro (1 GB, a 2 GB swapfile is created by startup.sh). Upgrade path: set
# MACHINE_TYPE=e2-small and run: gcloud compute instances stop/set-machine-type/start (VM stop needed), data disk is kept.
MACHINE_TYPE=e2-micro
DATA_DISK_GB=20
VM_NAME=e3-tracking
REPO=e3-tracking
BUCKET=e3-tracking-backups-${PROJECT_ID}
ALERT_EMAIL=you@e3-services.com
# Proxy subnet inside the compose network plus loopback (05-cutover.sh --via-tunnel posts from inside the app container, peer 127.0.0.1).
TRUSTED_PROXY_CIDR=172.28.0.8/29,127.0.0.1/32
