# Container runtime (D-66, T-5-00). Copy to .env.docker (gitignored) and adjust. See docs/DEPLOY.md.
# Mirrors .env.example with container paths.

# Port inside the container (compose maps host 3020 -> this).
PORT=3001
HOST=0.0.0.0

# SQLite and uploads live on the e3_data volume mounted at /data.
E3_DB_PATH=/data/e3-tracking.sqlite
E3_FILES_PATH=/data/files

# Auth mode: local (default) or proxy (edge profiles, T-5-06; set E3_AUTH_MODE=proxy in the shell or compose .env, it overrides this).
AUTH_MODE=local
E3_LOCAL_USER_NAME=Container user

# Default project key for the MCP entrypoint.
E3_PROJECT_KEY=

# Backup job: nightly hour (UTC), directory, retention per project.
BACKUP_HOUR_UTC=2
BACKUP_DIR=/data/backups
BACKUP_KEEP=14

# --- Edge profile (T-5-06, D-72 item 4): see docs/DEPLOY.md "Edge profile / proxy auth" ---
# Public host name Caddy gets a certificate for, and the Workspace domain allowed to sign in.
HOSTNAME=tracking.example.com
WORKSPACE_DOMAIN=example.com
# Google OAuth client (console steps: docs/DEPLOY.md GCP chapter). Redirect URI: https://<HOSTNAME>/oauth2/callback
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
# 32 random bytes, base64: openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_COOKIE_SECRET=
# Network the app trusts X-Forwarded-Email from; required in production when AUTH_MODE=proxy.
# Compose default is the fixed proxy addresses 172.28.0.8/29 on the e3 network.
TRUSTED_PROXY_CIDR=172.28.0.8/29
# edge-fake only: the identity the test proxy injects.
FAKE_EMAIL=tester@example.com
FAKE_NAME=Fake Tester

# Uncomment for the edge profiles (compose interpolation; pass --env-file .env.docker).
# E3_AUTH_MODE=proxy
