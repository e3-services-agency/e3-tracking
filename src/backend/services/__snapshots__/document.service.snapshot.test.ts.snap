window.dataLayer = window.dataLayer || [];
window.dataLayer.push({ bloomreach: null }); // reset, so nothing leaks from the previous event
window.dataLayer.push({
  event: 'voucher_notification', // the site's dataLayer event carrying this Bloomreach event (set dl_event_name in the plan)
  bloomreach: {
    event: 'voucher_notification',
    properties: {
      // Optional:
      available: 'string',
      pool name: 'string',
      threshold: 'string',
      total: 'string',
    },
  },
});

