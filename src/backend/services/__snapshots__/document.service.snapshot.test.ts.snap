      "codegen": {
        "datalayer": "// E3's recommended practice (D-63): one namespaced 'bloomreach' object on the site's existing
// event, so GA4 and other keys on the dataLayer root are never touched. The client may structure
// the dataLayer differently; validation always runs on the Bloomreach event payload, not here.
window.dataLayer = window.dataLayer || [];
window.dataLayer.push({ bloomreach: null }); // reset, so nothing leaks from the previous event
window.dataLayer.push({
  event: 'received_referee_reward', // the site's dataLayer event carrying this Bloomreach event (set dl_event_name in the plan)
  bloomreach: {
    event: 'received_referee_reward',
    properties: {
      // Optional:
      call_to_action_url: 'string',
      campaign_name: 'string',
      coupon_code: 'string',
      coupon_expiry: 'string',
      currency_symbol: 'string',
      email: 'string',
      experiment_name: 'string',
      firstname: 'string',
      fulfilled_by: 'string',
      locale_code: 'string',
      offer_call_to_action_copy: 'string',
      offer_name: 'string',
      offer_subject_copy: 'string',
      offer_terms_url: 'string',
      offer_type: 'string',
      referee_reward: 'string',
      referrer_first_name: 'string',
      referrer_last_name: 'string',
      referrer_reward: 'string',
      reward_amount: 123,
      reward_type: 'string',
      source: 'string',
      surname: 'string',
    },
  },
});",
