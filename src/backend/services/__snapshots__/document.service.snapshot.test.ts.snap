//  2. Tag: the E3 Bloomreach tag (custom template) reads the Data Layer Variable "bloomreach".
//  3. The tag calls the Web SDK: brweb.track('registered_as_referrer', brPayload(dataLayer.bloomreach, BR_RULES));
//  4. One tag serves every event (it reads bloomreach.event); only the trigger differs per site event.",
        "note": "",
        "sdk_default_properties": "",
        "sdk_emits": "",
        "tracking_api": "// customer_ids must match the project's hard ID; see https://documentation.bloomreach.com/data-hub/reference/tracking-api-overview
// Optional properties: campaign_name, customer_segment, dashboard_link, email, experiment_name, firstname, locale_code, offer_call_to_action_copy, offer_name, offer_subject_copy, offer_type, referee_reward, referrer_reward, share_link, source, surname

{
  "customer_ids": {
    "<hard_id>": "<customer_id>"
  },
