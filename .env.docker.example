# Container runtime (D-66, T-5-00). Copy to .env.docker (gitignored) and adjust. See docs/DEPLOY.md.
# Mirrors .env.example with container paths.

# Port inside the container (compose maps host 3020 -> this).
PORT=3001
HOST=0.0.0.0

# SQLite and uploads live on the e3_data volume mounted at /data.
E3_DB_PATH=/data/e3-tracking.sqlite
E3_FILES_PATH=/data/files

# Auth mode: local only (D-13). Remote exposure needs the step-2 identity proxy first (docs/DEPLOY.md).
AUTH_MODE=local
E3_LOCAL_USER_NAME=Container user

# Default project key for the MCP entrypoint.
E3_PROJECT_KEY=

# Backup job: nightly hour (UTC), directory, retention per project.
BACKUP_HOUR_UTC=2
BACKUP_DIR=/data/backups
BACKUP_KEEP=14
