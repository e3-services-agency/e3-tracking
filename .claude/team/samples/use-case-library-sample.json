{
  "format": "e3-use-case-library",
  "version": 1,
  "templates": [
    {
      "code": "UC-01",
      "name": "Abandoned cart",
      "type": "marketing",
      "description": "Recovers carts abandoned after an add-to-cart event with no completed checkout.",
      "tags": {
        "channels": ["email"],
        "goals": ["reactivate_customers"],
        "tiers": ["essentials"],
        "kpis": ["conversion_rate"],
        "industries": ["ecommerce"]
      },
      "flags": { "popular": true },
      "default_requirements": [
        {
          "target_kind": "variant",
          "standard_event": "add_to_cart",
          "level": "R",
          "note": "The abandoned-cart trigger."
        },
        {
          "target_kind": "variant_property",
          "standard_event": "add_to_cart",
          "property_name": "product_id",
          "level": "R"
        },
        {
          "target_kind": "variant_property",
          "standard_event": "add_to_cart",
          "property_name": "total_price",
          "level": "R"
        },
        {
          "target_kind": "event",
          "standard_event": "checkout",
          "level": "O",
          "note": "Suppresses the recovery email once checkout has started."
        },
        {
          "target_kind": "customer_property",
          "property_name": "email",
          "level": "R"
        }
      ]
    },
    {
      "code": "UC-02",
      "name": "Purchase confirmation",
      "type": "transactional",
      "description": "Sends a confirmation email for every successful purchase, with its line items.",
      "tags": {
        "channels": ["email"],
        "goals": ["increase_retention"],
        "tiers": ["essentials"],
        "kpis": ["revenue"],
        "industries": ["ecommerce", "travel", "retail"]
      },
      "flags": { "popular": true },
      "default_requirements": [
        {
          "target_kind": "variant",
          "standard_event": "purchase",
          "level": "R"
        },
        {
          "target_kind": "variant_property",
          "standard_event": "purchase",
          "property_name": "purchase_id",
          "level": "R"
        },
        {
          "target_kind": "variant_property",
          "standard_event": "purchase",
          "property_name": "total_price",
          "level": "R"
        },
        {
          "target_kind": "event_property",
          "standard_event": "purchase_item",
          "property_name": "total_price",
          "level": "R",
          "note": "Standard field total_price; the client's purchase_item event calls this property price."
        },
        {
          "target_kind": "event_property",
          "standard_event": "purchase_item",
          "property_name": "total_quantity",
          "level": "R",
          "note": "Standard field total_quantity; the client's purchase_item event calls this property quantity."
        },
        {
          "target_kind": "customer_property",
          "property_name": "email",
          "level": "R"
        },
        {
          "target_kind": "catalog_attribute",
          "field_name": "image",
          "level": "O",
          "note": "Product image for the confirmation email template."
        },
        {
          "target_kind": "consent",
          "property_name": "newsletter",
          "level": "R"
        }
      ]
    },
    {
      "code": "UC-03",
      "name": "Back in stock",
      "type": "marketing",
      "description": "Notifies a customer when a viewed, out-of-stock product becomes available again.",
      "tags": {
        "channels": ["email", "sms"],
        "goals": ["reactivate_customers"],
        "tiers": ["advanced"],
        "kpis": ["conversion_rate"],
        "industries": ["ecommerce", "retail"]
      },
      "flags": { "new": true },
      "default_requirements": [
        {
          "target_kind": "event_property",
          "standard_event": "view_item",
          "property_name": "product_id",
          "level": "R"
        },
        {
          "target_kind": "event_property",
          "standard_event": "view_item",
          "property_name": "stock_level",
          "level": "R"
        },
        {
          "target_kind": "customer_property",
          "property_name": "phone",
          "level": "O"
        },
        {
          "target_kind": "event",
          "event_name": "wishlist_add",
          "level": "R",
          "note": "Deliberately unresolvable on the data-mapping fixture (no wishlist_add event is mapped, and it is not a Bloomreach standard event); demonstrates a gap requirement."
        }
      ]
    }
  ]
}
