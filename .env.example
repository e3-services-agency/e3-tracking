# Local dev runtime (D-09, D-12, D-13, D-23). See docs/QA-LOCAL.md (T-1-10) for details.

# Port the Express API listens on (npm run dev:api / npm run dev).
PORT=3001

# SQLite database file path. Use ':memory:' for a throwaway/ephemeral database.
E3_DB_PATH=./data/e3-tracking.sqlite

# Auth mode: 'local' (default) treats every request as a single local admin user (D-13).
AUTH_MODE=local

# Display name recorded as the actor on history entries and QA runs in local mode.
# Falls back to git `user.name`, then "Local user" (D-25 Q8).
E3_LOCAL_USER_NAME=

# Default project key for the MCP server (phase 2) when a tool call omits project_key (D-25 Q7).
E3_PROJECT_KEY=

# Local file store root for uploaded assets (client logos, imported exports), D-09/D-12.
E3_FILES_PATH=./data/files

# Listen address. Unset locally (dual-stack); the container image sets 0.0.0.0 (D-66, docs/DEPLOY.md).
# HOST=

# Set to 1 to serve dist/ under /tracking-plan/ from the API process outside NODE_ENV=production (D-66).
# SERVE_STATIC=

# Shared commenters: External GIS Web client ID (public; no client secret).
GOOGLE_COMMENT_CLIENT_ID=
# Exact browser origin, no trailing slash. Local development: http://localhost:3000
E3_PUBLIC_ORIGIN=http://localhost:3000
# Edge deployment only: borrow verified Internal proxy sessions without widening staff login.
COMMENT_STAFF_SESSION=0

# Dedicated Claude HTTPS MCP OAuth connector. Default disabled; requires HTTPS E3_PUBLIC_ORIGIN, WORKSPACE_DOMAIN and production proxy auth.
E3_MCP_HTTP_ENABLED=0
