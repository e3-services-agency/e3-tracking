        "tracking_api": "// customer_ids must match the project's hard ID; see https://documentation.bloomreach.com/data-hub/reference/tracking-api-overview
// Optional properties: action, brand, product_id, product_ids, product_list, size, title, total_price, total_quantity

{
  "customer_ids": {
    "<hard_id>": "<customer_id>"
  },
  "event_type": "cart_update",
  "properties": {
    "action": "add",
    "brand": "string",
    "product_id": "string",
    "product_ids": "string",
    "product_list": "string",
    "size": "string",
    "title": "string",
    "total_price": 123,
    "total_quantity": 1
  }
}

