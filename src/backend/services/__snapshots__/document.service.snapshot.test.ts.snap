        "gtm_template": "// E3 shared transformation, version 1. A fixed artefact: do not edit per client.
// Ships as the E3 GTM custom template and as this JS helper.
<BR_PAYLOAD_SOURCE>

// This event's state lists and totals (from the property kinds in the plan):
var BR_RULES = [];

// GTM custom template setup
//  1. Trigger: Custom Event "flyer", fires only when the Data Layer Variable "bloomreach" is defined.
//  2. Tag: the E3 Bloomreach tag (custom template) reads the Data Layer Variable "bloomreach".
//  3. The tag calls the Web SDK: brweb.track('flyer', brPayload(dataLayer.bloomreach, BR_RULES));
//  4. One tag serves every event (it reads bloomreach.event); only the trigger differs per site event.",
        "note": "",
        "sdk_default_properties": "",
        "sdk_emits": "",
        "tracking_api": "// customer_ids must match the project's hard ID; see https://documentation.bloomreach.com/data-hub/reference/tracking-api-overview
// Optional properties: flyer_name, is_flyer_order, order_date, packed_date, purchase_id

{
  "customer_ids": {
    "<hard_id>": "<customer_id>"
  },
  "event_type": "flyer",
  "properties": {
    "flyer_name": "string",
    "is_flyer_order": true,
    "order_date": "string",
    "packed_date": 123,
    "purchase_id": "string"
  }
}

