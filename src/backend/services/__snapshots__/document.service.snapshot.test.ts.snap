      "class": "custom",
      "codegen": {
        "datalayer": "// E3's recommended practice (D-63): one namespaced 'bloomreach' object on the site's existing
// event, so GA4 and other keys on the dataLayer root are never touched. The client may structure
// the dataLayer differently; validation always runs on the Bloomreach event payload, not here.
window.dataLayer = window.dataLayer || [];
window.dataLayer.push({ bloomreach: null }); // reset, so nothing leaks from the previous event
window.dataLayer.push({
  event: 'cart_update', // the site's dataLayer event carrying this Bloomreach event (set dl_event_name in the plan)
  bloomreach: {
    event: 'cart_update',
    properties: {
      // Optional:
      action: 'add',
      brand: 'string',
      product_id: 'string',
      product_ids: 'string',
      product_list: 'string',
      size: 'string',
      title: 'string',
    },
    // Computed by brPayload from items: total_price, total_quantity
    // (put a value in properties to override a computed one)
    items: [ // the whole collection after the action, one entry per line
      {
        price: 123,
        quantity: 1,
      },
    ],
  },
});",
        "gtm": "// E3's recommended practice (D-63): one namespaced 'bloomreach' object on the site's existing
// event, so GA4 and other keys on the dataLayer root are never touched. The client may structure
// the dataLayer differently; validation always runs on the Bloomreach event payload, not here.
window.dataLayer = window.dataLayer || [];
window.dataLayer.push({ bloomreach: null }); // reset, so nothing leaks from the previous event
window.dataLayer.push({
  event: 'cart_update', // the site's dataLayer event carrying this Bloomreach event (set dl_event_name in the plan)
  bloomreach: {
    event: 'cart_update',
    properties: {
      // Optional:
      action: 'add',
      brand: 'string',
      product_id: 'string',
      product_ids: 'string',
      product_list: 'string',
      size: 'string',
