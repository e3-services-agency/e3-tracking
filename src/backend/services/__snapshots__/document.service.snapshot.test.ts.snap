        "tracking_api": "// customer_ids must match the project's hard ID; see https://documentation.bloomreach.com/data-hub/reference/tracking-api-overview
// Optional properties: available, pool name, threshold, total

{
  "customer_ids": {
    "<hard_id>": "<customer_id>"
  },
  "event_type": "voucher_notification",
  "properties": {
    "available": "string",
    "pool name": "string",
    "threshold": "string",
    "total": "string"
  }
}

